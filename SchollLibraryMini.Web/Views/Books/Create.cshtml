<form method="post" action="books/create">
    <div class="form-group">
        <label for="book_title">Заглавие на книга</label>
        <input type="text" class="form-control" name="title" id="book_title" placeholder="въведете името на книгата тук">
        <small class="form-text text-muted">Въведете заглавието само на кирилица</small>
    </div>

    <div class="form-group">
        <label for="book_author">Автор на книга</label>
        <input type="text" class="form-control" name="author" id="book_author">
    </div>

    <button type="submit" class="btn btn-primary my-3">Запази</button>
</form>
